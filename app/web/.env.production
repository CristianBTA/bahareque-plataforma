NEXT_PUBLIC_CDN_URL=https://cdn.guadua.example
NEXT_PUBLIC_ANALITICA_ID=GD-PROD-0042
NEXT_PUBLIC_VERSION=3.14.2

# --- Pagos (PagosYa) ---
NEXT_PUBLIC_PAGOSYA_PUBLICABLE=pagosya_pub_FALSO_4f2a91d3e8
