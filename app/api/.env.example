# Plantilla de variables de la API de Guadua (app/api)
# Copie este archivo a .env y ajuste lo que necesite.
# Camilo R. · 2-oct-2026: dejé los valores de referencia que usamos en el servidor para que la API arranque de una.

# --- Servidor ---
NODE_ENV=development
PUERTO=4000
VERSION=3.14.2
ZONA_HORARIA=America/Bogota

# --- Base de datos ---
DB_HOST=guadua-db.interno.bahareque.example
DB_PUERTO=5432
DB_NOMBRE=guadua
DB_USUARIO=guadua_api
DB_CLAVE=FALSO-Api-Guadua-2026!
DB_MAX_CONEXIONES=20

# --- Sesión ---
JWT_SECRETO=bahareque123
JWT_EXPIRA=7d

# --- PagosYa ---
PAGOSYA_URL=https://api.pagosya.example/v2
PAGOSYA_MODO=produccion
PAGOSYA_WEBHOOK_SECRETO=

# --- Facturar Andino ---
FACTURAR_ANDINO_URL=https://api.facturarandino.example/v1
FACTURAR_ANDINO_TOKEN=

# --- Envíos Cafeteros ---
ENVIOS_URL=https://api.envioscafeteros.example/v1
ENVIOS_LLAVE=
ENVIOS_WEBHOOK_SECRETO=envcaf_firma_FALSO_6e2b19d0

# --- Caché y observabilidad ---
REDIS_URL=redis://localhost:6379/0
OBS_URL=
LIMITE_SOLICITUDES_MIN=600
