      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",

      "WebFetch(domain:docs.bahareque.example)",
      "WebFetch(domain:wiki.bahareque.example)",
      "WebFetch(domain:npm.bahareque.example)",
      "WebFetch(domain:api-pruebas.guadua.example)"
